# Local env (machine-specific paths)
.env

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/

# Server runtime / generated
server/.env
server/cache/
server/server.log
server/server.pid
server/face_indexer.log
server/face_indexer.pid
server/prewarm.log
# Stray venv artifacts that ended up in server/ (real venv is server/.venv/)
server/bin/
server/lib/
server/lib64
server/pyvenv.cfg
server/include/

# Android / Gradle
.gradle/
build/
android/local.properties
android/.idea/
android/captures/
*.iml

# iOS / Xcode (Chitra.xcodeproj is generated from ios/project.yml)
ios/build/
ios/Chitra.xcodeproj/
DerivedData/
*.xcuserdatad
xcuserdata/

# OS / editor
.DS_Store
.vscode/
.idea/

# root-level runtime pid
server.pid
server/.venv-mac/

# Android build artifact served for sideloading (not versioned)
server/static/*.apk
