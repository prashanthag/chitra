# Chitra server config. Copy to .env and edit. Loaded automatically at startup.

# Absolute path to the media directory to scan (required).
PHOTO_ROOT=/path/to/photos

# Bind address and port for the Flask server.
HOST=0.0.0.0
PORT=8000

# Video hardware acceleration backend. "auto" detects the GPU at startup:
# NVIDIA NVENC, Intel Quick Sync, Apple VideoToolbox, AMD AMF, or VAAPI, else CPU.
# Force one with: nvidia | qsv | videotoolbox | amf | vaapi | cpu
GPU_BACKEND=auto

# VAAPI render node (Linux/Intel/AMD only; used when GPU_BACKEND resolves to vaapi).
# VAAPI_DEVICE=/dev/dri/renderD128

# face_indexer.py: cap number of media items processed (0 = no limit).
FACE_LIMIT=0
